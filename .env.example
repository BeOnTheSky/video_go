# xilixili Environment Configuration
# Copy to .env:  cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=xilixili
MYSQL_USER=xilixili_user
MYSQL_PASSWORD=xilixili_dev_password

# MinIO (must match mc setup credentials in docker-compose.yml)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=xilixili-videos
MINIO_PUBLIC_ENDPOINT=localhost:9000

# JWT
JWT_SECRET=change-this-to-a-random-secret

# RabbitMQ
RABBITMQ_USER=xilixili
RABBITMQ_PASS=change-this-to-a-random-password

# Docker build mirrors (change if not in China)
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com
APK_MIRROR=mirrors.aliyun.com
